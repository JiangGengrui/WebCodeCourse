{
  "name": "todo-v3.1",
  "version": "3.1.0",
  "private": true,
  "type": "module",
  "description": "待办事项 V3.1 —— 实验2 Part3：关键字搜索与实时统计 + 拖拽排序与持久化",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run tests/",
    "test:round1": "vitest run round1/",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:report": "eslint src/ -f stylish",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"round1/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  }
}

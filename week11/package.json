{
    "name": "todo-v4",
    "version": "4.0.0",
    "private": true,
    "type": "module",
    "description": "待办事项 V4.0 —— React 组件化重构（Vite + React 18 + TypeScript strict + Vitest）",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src/ --ext .ts,.tsx",
        "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\""
    },
    "dependencies": {
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    },
    "devDependencies": {
        "@types/react": "^18.3.3",
        "@types/react-dom": "^18.3.0",
        "@typescript-eslint/eslint-plugin": "^7.18.0",
        "@typescript-eslint/parser": "^7.18.0",
        "@vitejs/plugin-react": "^4.3.1",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^9.1.0",
        "prettier": "^3.3.0",
        "typescript": "^5.5.0",
        "vite": "^5.4.0",
        "vitest": "^2.0.0"
    }
}
